{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "vibian-system": {
        "type": "local",
        "command": ["/usr/bin/vibian", "mcp", "--agent", "opencode"]
      },
      "vibian-computer": {
        "type": "local",
        "command": ["/usr/bin/vibian", "mcp", "computer", "--agent", "opencode"]
      }
    }
  }
}
